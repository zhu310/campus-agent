APP_NAME=CampusAgent Pro API
DEBUG=true
DEMO_MODE=false

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/campus_agent
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=campus_knowledge

MODEL_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_LLM_MODEL=deepseek-chat

# Optional local/offline chat model.
QWEN_BASE_URL=http://127.0.0.1:11434/v1
QWEN_API_KEY=ollama
QWEN_LLM_MODEL=qwen2.5:7b-instruct
QWEN_EMBEDDING_MODEL=

# Recommended embedding setup: local Ollama bge-m3.
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=bge-m3

TOP_K=5
CHUNK_SIZE=700
CHUNK_OVERLAP=120
CORS_ORIGINS=http://localhost:5173
